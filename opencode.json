{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "model": "openai/fait-gpt-5.4-custom",
  "small_model": "openai/fait-routing-gpt-5.4-nano",
  "enabled_providers": ["openai"],
  "instructions": ["DESIGN.md"],
  "permission": {
    "bash": "ask",
    "edit": "ask",
    "write": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "skill": "allow"
  },
  "agent": {
    "orchestrator": { "model": "openai/fait-gpt-5.4-Custom" },
    "technical-functional-analyst": { "model": "openai/fait-gpt-5.4-Custom" },
    "sad-architect-reviewer": { "model": "openai/fait-gpt-5.4-Custom" },
    "planner": { "model": "openai/fait-gpt-5.4-Custom" },
    "domain-engineer": { "model": "openai/fait-gpt-5.k2.6-custom" },
    "persistence-engineer": { "model": "openai/fait-gpt-5.k2.6-custom" },
    "web-engineer": { "model": "openai/fait-gpt-5.k2.6-custom" },
    "frontend-engineer": { "model": "openai/fait-gpt-5.k2.6-custom" },
    "test-engineer": { "model": "openai/fait-gpt-5.k2.6-custom" },
    "spec-reviewer": { "model": "openai/fait-gpt-5.4-custom" },
    "code-reviewer": { "model": "openai/fait-gpt-5.k2.6-custom" },
    "documentation-engineer": { "model": "openai/fait-gpt-5.4-custom" }
  }
}